# ---------------------------------------------------------------------------
# SmartradeBot — environment variables
# Copy to .env.local for local dev. Set the same keys in the Vercel dashboard.
# The site runs without any of these; features light up as you add them.
# ---------------------------------------------------------------------------

# Public base URL (no trailing slash). Vercel sets this per-deployment; for
# local dev leave the default. In production set this to https://smartradebot.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Lead capture / CRM (systeme.io) --------------------------------------
# Account: Settings > Public API keys
SYSTEMEIO_API_KEY=
# Every contact synced from the site gets a "funnel_stage" custom field set to
# whatever `source` the call used (contact_form, exit_popup,
# referral_partner_interest, checkout_no_exness, exness_verified, purchased,
# …) — create that field once in systeme.io (Contacts > Settings > Custom
# fields, slug "funnel_stage") and filter/segment on its value. No env var
# needed for this; it works automatically as soon as SYSTEMEIO_API_KEY is set.
#
# Optional: numeric tag id applied only to "checkout_no_exness" leads (they
# started buying, picked the standard price, and left) — the one tag most
# free systeme.io plans allow, reserved for this highest-value automation
# since systeme.io can only trigger a Rule/Workflow off a tag, not a custom
# field. If your plan allows more tags, extend the same pattern in
# src/app/api/leads/route.ts for other sources.
SYSTEMEIO_TAG_ID=
# Optional: separate numeric tag id applied only when a buyer's Exness
# affiliation is confirmed live (src/app/api/exness/verify-request). Only
# useful if your plan allows a second tag — otherwise rely on the
# funnel_stage="exness_verified" field value instead.
SYSTEMEIO_TAG_ID_EXNESS_VERIFIED=
# Optional: numeric tag id applied when a purchase is confirmed (any payment
# provider). Same free-plan caveat as above — funnel_stage="purchased" works
# without it.
SYSTEMEIO_TAG_ID_PURCHASED=

# --- Transactional email (Zoho Mail SMTP) --------------------------------
# Use an app-specific password, not your regular Zoho login password:
# Zoho Mail > Settings > Security > App Passwords.
ZOHO_SMTP_USER=
ZOHO_SMTP_PASS=
# Optional overrides — defaults are smtp.zoho.com:465
ZOHO_SMTP_HOST=
ZOHO_SMTP_PORT=
# Optional: "from" address if different from ZOHO_SMTP_USER
ZOHO_FROM_EMAIL=
# Where new-order notifications are sent (defaults to NEXT_PUBLIC_CONTACT_EMAIL)
ORDER_NOTIFICATION_EMAIL=

# --- Stripe (card payments + signal subscriptions) ----------------------
# No per-product Price IDs needed — checkout builds the exact amount from
# src/lib/products.ts on the fly (Stripe's price_data), so both the standard
# and Exness-referral price work with just these two keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Crypto payments (NOWPayments, USDT only — TRC20 or BEP20) ---------
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# --- Mercado Pago (Checkout Pro — card/cuotas/cash for Argentina) ------
# Dashboard: https://www.mercadopago.com.ar/developers/panel
MERCADOPAGO_ACCESS_TOKEN=
# Webhook signing secret (same dashboard, under the webhook you configure
# at https://api.mercadopago.com/v1/payments/... -> notification_url).
# Without it, incoming webhooks aren't signature-checked — set it before
# going live.
MERCADOPAGO_WEBHOOK_SECRET=
# "true" to send checkouts to the sandbox payment page while testing.
MERCADOPAGO_SANDBOX=
# Defaults to "USD". Most AR seller accounts are ARS-only — if preferences
# get rejected, either ask Mercado Pago to enable USD for this account, or
# set this to ARS and provide MERCADOPAGO_FX_RATE below.
MERCADOPAGO_CURRENCY=
# USD -> MERCADOPAGO_CURRENCY conversion rate, only used when the currency
# above isn't USD. A fixed rate you control — nothing here guesses one.
MERCADOPAGO_FX_RATE=

# --- Telegram (channel/group access) ---------------------------------
# Message @BotFather to create the bot and get its token. The bot must be an
# admin of each channel/group below (with "Invite users via link"
# permission) — each *_ID is that chat's id (add the bot, then forward any
# message from the channel to @userinfobot to read the id, usually a
# negative number like -1001234567890).
#
# Each one-time signal purchase (src/lib/products.ts, the `signals` array)
# grants access to one or more of these channels — the XAUUSD and BTCUSD
# packs each unlock their own channel; the multi-asset pack reuses those two
# plus the EUR/USD one. TELEGRAM_CHANNEL_ZIZA_ID is a different kind of
# channel: a bot-owners follow-up/support group (daily analysis, config
# tweaks), added on top of ZIZA's normal manual-delivery flow, not instead
# of it. Missing a channel's id just skips that invite link (logged, not
# fatal) rather than failing the whole purchase.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_XAUUSD_ID=
TELEGRAM_CHANNEL_BTCUSD_ID=
TELEGRAM_CHANNEL_EURUSD_ID=
TELEGRAM_CHANNEL_ZIZA_ID=

# --- Exness account verification ---------------------------------------
# Secret used to sign the "your Exness account is verified" resume link
# (src/lib/exness.ts). Set this to any long random string before going live
# — without it the site falls back to an insecure shared dev value.
EXNESS_VERIFY_SECRET=
# Exness Partner API credentials, from https://my.exnessaffiliates.com — used
# to check live whether a customer's email is affiliated to our partner link
# (src/lib/exness.ts: checkExnessAccount, reused by every product that needs
# this check — not just bots/indicators). Exness JWTs expire, so the real
# credential is your partner login/password: the code re-authenticates
# (POST /api/auth/) on every check rather than relying on a stored token.
EXNESS_AFFILIATES_LOGIN=
EXNESS_AFFILIATES_PASSWORD=
# Fallback: a manually obtained JWT, used only if the login/password above
# aren't set. Will stop working whenever Exness expires it — prefer the
# login/password pair for anything long-lived.
EXNESS_API_KEY=

# --- Public links ----------------------------------------------------
# Exness referral URL
NEXT_PUBLIC_EXNESS_REFERRAL_URL=
# Google Calendar appointment / Google Meet booking page
NEXT_PUBLIC_MEET_URL=
# Telegram contact (https://t.me/...)
NEXT_PUBLIC_TELEGRAM_URL=
# Support email address
NEXT_PUBLIC_CONTACT_EMAIL=
